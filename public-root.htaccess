# MagicFrames — rules for the website root (public_html).
#
# This file is copied into the deploy bundle as ".htaccess". Upload it to the
# top level of public_html alongside index.html.

# Serve index.html for the root URL. This is the default on most servers, but
# stating it explicitly avoids a 403 if the server's default differs.
DirectoryIndex index.html index.php

# Never show a directory listing.
Options -Indexes

# Friendly 404 page (generated by the site build).
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Defensive: if any source files were ever uploaded by mistake, do not serve
# them. They are not secret, but they do not belong on a web server.
# ---------------------------------------------------------------------------
<FilesMatch "\.(ts|tsx|md|lock|log)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(package\.json|package-lock\.json|tsconfig\.json|tsconfig\.tsbuildinfo|next\.config\.mjs|postcss\.config\.mjs|tailwind\.config\.ts|next-env\.d\.ts|\.eslintrc\.json|\.gitignore|\.env.*)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Force HTTPS
# ---------------------------------------------------------------------------
# Recommended: use hPanel -> Security -> SSL -> "Force HTTPS" instead of this.
#
# Only uncomment the lines below AFTER your SSL certificate is active and
# working. Enabling it too early can cause a redirect loop.
#
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ---------------------------------------------------------------------------
# Caching: hashed build assets can be cached hard; HTML must not be.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|jpg|jpeg|png|webp|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
