# Magicframes Wedding Company — environment configuration
#
# Copy this file to `.env.local` and fill in the values you need.
# All variables are OPTIONAL for local development.

# --- Supabase (optional) ---------------------------------------------------
# When BOTH of these are set, the app uses the Supabase-backed data provider.
# When they are omitted, the app automatically falls back to a local
# localStorage-backed provider seeded with placeholder demo data, so the site
# runs and is fully testable with NO external accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin dashboard ------------------------------------------------------
# Password gate for the /admin dashboard. If unset, a development default is
# used in the local fallback. Always set a strong value in production.
NEXT_PUBLIC_ADMIN_PASSWORD=
