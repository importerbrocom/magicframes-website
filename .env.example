# MagicFrames — environment configuration
#
# Copy this file to `.env.local` and change values only if you need to.
# Everything here is OPTIONAL: the defaults are correct for a normal
# Hostinger deployment.
#
# IMPORTANT: this site is a static export, so these values are baked into the
# JavaScript at BUILD time. Change one => run `npm run build` again.
#
# Your MySQL credentials do NOT belong here. They live server-side only, in
# api/config.php (which is gitignored and never sent to the browser).

# --- Backend API location ---------------------------------------------------
# Where the PHP API lives. The default is the relative path "/api", which is
# correct when the site and the api/ folder share a document root (the normal
# setup described in the README). Only set this if the API is on a different
# domain, e.g. https://api.example.com
# NEXT_PUBLIC_API_BASE_URL=/api

# --- Local design mode (no database) ---------------------------------------
# Set to 1 to bypass the API entirely and keep content in this browser's
# localStorage, seeded with placeholder demo data. Useful for working on the
# design with no MySQL or PHP running. Leave unset for real deployments.
# NEXT_PUBLIC_USE_LOCAL=1

# --- Local design mode password --------------------------------------------
# Only used when NEXT_PUBLIC_USE_LOCAL=1. Real deployments authenticate against
# the PHP backend instead (see `php api/setup_admin.php`), so this value is
# irrelevant in production.
# NEXT_PUBLIC_ADMIN_PASSWORD=magicframes
